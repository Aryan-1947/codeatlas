# Copy this file to `.env` in the same folder, then fill in real values.
# `.env` is gitignored — never commit it, never paste real values into chat.

NODE_ENV=development
PORT=4000

# Must match the URL your Vite frontend runs on locally.
FRONTEND_ORIGIN=http://localhost:5173

# console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=your_groq_api_key_here

# openai/gpt-oss-120b is Groq's current production model and supports
# strict JSON-schema output, which the graph generation step relies on.
# llama-3.3-70b-versatile was shut down by Groq on 2026-08-16 — do not use it.
# Check console.groq.com/docs/models if you want to try something else.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Without it, GitHub calls run at 60 req/hr (shared across all
# your users). With it, 5,000 req/hr. Fine-grained token, scoped to
# "Public Repositories (read-only)" only — see chat for setup steps.
GITHUB_TOKEN=github_pat_your_real_token_here
